rules_version = '2';

// Vigília — regras do Firestore.
//
// Todo acesso de dados passa pela Cloud Function `api` (Admin SDK, que não é
// afetado por estas regras). Clientes web NÃO acessam o Firestore diretamente,
// portanto o acesso público fica integralmente negado.
//
// Se no futuro a SPA precisar ler/escrever direto no Firestore, adicione
// Firebase Authentication antes de abrir qualquer regra abaixo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
